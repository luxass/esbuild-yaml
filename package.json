{
  "name": "esbuild-yaml",
  "version": "3.2.1",
  "description": "An esbuild plugin, that allows imports of YAML files",
  "keywords": [
    "esbuild",
    "plugin",
    "yaml",
    "yaml esbuild",
    "yaml import",
    "yaml plugin"
  ],
  "homepage": "https://github.com/luxass/esbuild-yaml",
  "bugs": {
    "url": "https://github.com/luxass/esbuild-yaml/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/esbuild-yaml.git"
  },
  "files": [
    "dist",
    "yaml.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "esbuild": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "esbuild": ">=0.19.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
